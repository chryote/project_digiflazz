meta {
  name: Pending Callback Sukses 1 Tagihan (630000000001)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/transaction
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

script:pre-request {
  const username = bru.getVar("username") || "";
  const apiKey = bru.getVar("api_key") || "";
  const refId = "PEND-01-" + Date.now();
  const crypto = require("crypto");
  const sign = crypto.createHash("md5").update(username + apiKey + refId).digest("hex");
  bru.setVar("pend_1_sign", sign);
  bru.setVar("pend_1_ref_id", refId);
}

body:json {
  {
    "commands": "pay-pasca",
    "username": "{{username}}",
    "buyer_sku_code": "pln",
    "customer_no": "630000000001",
    "ref_id": "{{pend_1_ref_id}}",
    "sign": "{{pend_1_sign}}",
    "callback_url": "{{base_url}}/api/v1/mock-webhook",
    "testing": true
  }
}

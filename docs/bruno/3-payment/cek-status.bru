meta {
  name: Cek Status / Idempotency Replay (Same ref_id)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/transaction
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

script:pre-request {
  const username = bru.getVar("username") || "";
  const apiKey = bru.getVar("api_key") || "";
  const refId = bru.getVar("last_ref_id") || "PAY-SAMPLE-001";
  const crypto = require("crypto");
  const sign = crypto.createHash("md5").update(username + apiKey + refId).digest("hex");
  bru.setVar("status_check_sign", sign);
  bru.setVar("check_ref_id", refId);
}

body:json {
  {
    "commands": "pay-pasca",
    "username": "{{username}}",
    "buyer_sku_code": "pln",
    "customer_no": "530000000001",
    "ref_id": "{{check_ref_id}}",
    "sign": "{{status_check_sign}}",
    "testing": true
  }
}

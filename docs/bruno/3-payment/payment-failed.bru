meta {
  name: Payment PLN Gagal (530000000006)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/transaction
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

script:pre-request {
  const username = bru.getVar("username") || "";
  const apiKey = bru.getVar("api_key") || "";
  const refId = "PAY-FAIL-" + Date.now();
  const crypto = require("crypto");
  const sign = crypto.createHash("md5").update(username + apiKey + refId).digest("hex");
  bru.setVar("pay_fail_sign", sign);
  bru.setVar("fail_ref_id", refId);
}

body:json {
  {
    "commands": "pay-pasca",
    "username": "{{username}}",
    "buyer_sku_code": "pln",
    "customer_no": "530000000006",
    "ref_id": "{{fail_ref_id}}",
    "sign": "{{pay_fail_sign}}",
    "testing": true
  }
}

meta {
  name: Payment PLN Sukses (530000000001)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/transaction
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

script:pre-request {
  const username = bru.getVar("username") || "";
  const apiKey = bru.getVar("api_key") || "";
  const refId = "PAY-BRU-" + Date.now();
  bru.setVar("last_ref_id", refId);
  const crypto = require("crypto");
  const sign = crypto.createHash("md5").update(username + apiKey + refId).digest("hex");
  bru.setVar("pay_sign_success", sign);
  bru.setVar("dynamic_ref_id", refId);
}

body:json {
  {
    "commands": "pay-pasca",
    "username": "{{username}}",
    "buyer_sku_code": "pln",
    "customer_no": "530000000001",
    "ref_id": "{{dynamic_ref_id}}",
    "sign": "{{pay_sign_success}}",
    "testing": true
  }
}

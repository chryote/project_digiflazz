meta {
  name: Login & Issue Bearer Token
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "password123",
    "device_name": "Bruno Client"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.data && body.data.token && body.data.token.access_token) {
      bru.setVar("token", body.data.token.access_token);
    }
  }
}

meta {
  name: Inquiry PLN Postpaid 2 Tagihan (530000000002)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/inquiry-pln
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

script:pre-request {
  const username = bru.getVar("username") || "";
  const apiKey = bru.getVar("api_key") || "";
  const customerNo = "530000000002";
  const crypto = require("crypto");
  const sign = crypto.createHash("md5").update(username + apiKey + customerNo).digest("hex");
  bru.setVar("inq_sign_postpaid_2", sign);
}

body:json {
  {
    "commands": "inq-pasca",
    "username": "{{username}}",
    "buyer_sku_code": "pln",
    "customer_no": "530000000002",
    "ref_id": "INQ-POST-002",
    "sign": "{{inq_sign_postpaid_2}}"
  }
}

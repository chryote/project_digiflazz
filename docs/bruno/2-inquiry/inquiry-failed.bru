meta {
  name: Inquiry PLN Gagal (530000000003)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/inquiry-pln
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

script:pre-request {
  const username = bru.getVar("username") || "";
  const apiKey = bru.getVar("api_key") || "";
  const refId = "INQ-BRU-FAIL-" + Date.now();
  bru.setVar("dynamic_inq_ref_id_fail", refId);
  const crypto = require("crypto");
  const sign = crypto.createHash("md5").update(username + apiKey + refId).digest("hex");
  bru.setVar("inq_sign_fail", sign);
}

body:json {
  {
    "commands": "inq-pasca",
    "username": "{{username}}",
    "buyer_sku_code": "pln",
    "customer_no": "530000000003",
    "ref_id": "{{dynamic_inq_ref_id_fail}}",
    "sign": "{{inq_sign_fail}}",
    "testing": true
  }
}

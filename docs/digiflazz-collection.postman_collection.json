            "body": {
              "mode": "raw",
              "raw": "{\n  \"commands\": \"pay-pasca\",\n  \"username\": \"{{username}}\",\n  \"buyer_sku_code\": \"pln\",\n  \"customer_no\": \"530000000001\",\n  \"ref_id\": \"{{dynamic_ref_id}}\",\n  \"sign\": \"{{dynamic_sign}}\",\n  \"testing\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/transaction",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaction"]
            },
            "description": "Execute successful PLN payment with ACID atomicity and pessimistic locking."
          }
        },
        {
          "name": "Cek Status / Idempotent Replay (Same ref_id)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var username = pm.collectionVariables.get('username') || '';",
                  "var apiKey = pm.collectionVariables.get('api_key') || '';",
                  "var refId = pm.collectionVariables.get('last_ref_id') || 'PAY-SAMPLE-001';",
                  "var sign = CryptoJS.MD5(username + apiKey + refId).toString();",
                  "pm.variables.set('check_ref_id', refId);",
                  "pm.variables.set('check_sign', sign);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"

{
  "info": {
    "_postman_id": "a9d8213b-1792-4f91-884b-012984189ac2",
    "name": "Digiflazz PLN API",
    "description": "Comprehensive API collection for Digiflazz PLN backend, compatible with Postman, Bruno, and Hoppscotch. Sourced using environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string",
      "description": "Set from your .env file"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string",
      "description": "Set from your .env file"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Bearer token obtained automatically from Login"
    },
    {
      "key": "last_ref_id",
      "value": "PAY-SAMPLE-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login & Issue Bearer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token && json.data.token.access_token) {",
                  "        pm.collectionVariables.set('token', json.data.token.access_token);",
                  "        console.log('Bearer token saved:', json.data.token.access_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"password123\",\n  \"device_name\": \"API Client\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticate merchant credentials and save personal access bearer token to collection variable."
          }
        },
        {
          "name": "Get Merchant Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Retrieve current authenticated merchant profile with balance and API key."
          }
        },
        {
          "name": "Logout & Revoke Bearer Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revoke active Sanctum bearer token."
          }
        },
        {
          "name": "Regenerate API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/regenerate-api-key",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "regenerate-api-key"]
            },
            "description": "Regenerate Digiflazz merchant development API key under database lock."
          }
        }
      ]
    },
    {
      "name": "2. PLN Inquiry",
      "item": [
        {
          "name": "Inquiry PLN Prepaid (1234554321)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var username = pm.collectionVariables.get('username') || '';",
                  "var apiKey = pm.collectionVariables.get('api_key') || '';",
                  "var customerNo = '1234554321';",
                  "var sign = CryptoJS.MD5(username + apiKey + customerNo).toString();",
                  "pm.variables.set('inq_prepaid_sign', sign);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

    {
      "name": "3. PLN Payment & Transactions",
      "item": [
        {
          "name": "Payment Sukses - 1 Lembar (530000000001)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var username = pm.collectionVariables.get('username') || '';",
                  "var apiKey = pm.collectionVariables.get('api_key') || '';",
                  "var refId = 'PAY-' + Date.now();",
                  "pm.collectionVariables.set('last_ref_id', refId);",
                  "var sign = CryptoJS.MD5(username + apiKey + refId).toString();",
                  "pm.variables.set('dynamic_ref_id', refId);",
                  "pm.variables.set('dynamic_sign', sign);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [

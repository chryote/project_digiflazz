            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commands\": \"pay-pasca\",\n  \"username\": \"{{username}}\",\n  \"buyer_sku_code\": \"pln\",\n  \"customer_no\": \"530000000001\",\n  \"ref_id\": \"{{check_ref_id}}\",\n  \"sign\": \"{{check_sign}}\",\n  \"testing\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/transaction",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaction"]
            },
            "description": "Re-submit the same ref_id to verify idempotent status check without double deduction."
          }
        },

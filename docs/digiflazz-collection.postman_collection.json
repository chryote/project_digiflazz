                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"customer_no\": \"1234554321\",\n  \"sign\": \"{{inq_prepaid_sign}}\"\n}"
